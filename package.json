{
  "name": "aegisops",
  "private": true,
  "workspaces": [
    "apps/web",
    "examples/shop-api"
  ],
  "engines": {
    "node": "22.23.1",
    "npm": "10.9.8"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "lint": "npm run lint --workspace apps/web",
    "typecheck": "npm run typecheck --workspaces",
    "format:check": "prettier --check apps/web examples/shop-api package.json",
    "format": "prettier --write apps/web examples/shop-api package.json",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspace examples/shop-api",
    "test:web": "npm run test --workspace apps/web"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "22.20.5",
    "prettier": "3.9.10"
  }
}
